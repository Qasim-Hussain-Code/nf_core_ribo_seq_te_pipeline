# Local working copy of the pipeline run (Nextflow work directory, container
# and pipeline-asset cache, full result tree, generated configs, logs). All
# regenerated by scripts/run_all.sh; only a curated, small subset is tracked
# directly under results/.
riboseq_run/
riboseq_nextflow_guide/

# Raw sequencing reads (fetched by scripts/03_download_fastq.sh)
raw_data/*.fastq.gz
raw_data/*.fastq

# Placeholder directories keep their README but nothing else
results/alignment/*
!results/alignment/README.md
results/genome/*
!results/genome/README.md
results/multiqc/*
!results/multiqc/README.md
results/pipeline_info/*
!results/pipeline_info/README.md
results/preprocessing/*
!results/preprocessing/README.md
results/ribowaltz/*
!results/ribowaltz/README.md
results/other/*
!results/other/README.md

# R / Bioconductor serialized objects (regenerable, not portable outside R)
*.rds
.Rhistory
.RData

# Python
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
*.swp
